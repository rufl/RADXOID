# Reproducible source and board selection for the Radxa ROCK 3A (lean).
# Android 11 is the last officially supported version for RK356X.
# RK356X não tem suporte oficial para Android 12+.
ANDROID_VERSION=11
MANIFEST_URL=https://github.com/radxa/manifests.git
MANIFEST_BRANCH=Android11_Radxa_rk12
MANIFEST_REVISION=116eac8ed8e7b29ff17d9a71fa8d1adcb442da57
MANIFEST_NAME=rockchip-r-release.xml

# Native display build. The *_box product is intentionally not selected.
PRODUCT_NAME=rk356x_rock_3a_r
PRODUCT_UBOOT_CONFIG=radxa_rock_3a
PRODUCT_KERNEL_CONFIG=rockchip_defconfig
PRODUCT_KERNEL_DTS=rk3568-rock-3a
TARGET_BUILD_VARIANT=userdebug

# Workspace location. Use the external USB drive when mounted so the
# 150 GB+ tree and out/ never touch the internal disk. Falls back to a
# local ./source when the drive is absent.
RADXOID_EXTERNAL="${RADXOID_EXTERNAL:-/run/media/lich/EdgeBKP/radxoid}"
if [[ -z "${SOURCE_DIR:-}" ]]; then
  if [[ -w "${RADXOID_EXTERNAL}" ]]; then
    SOURCE_DIR="${RADXOID_EXTERNAL}/source"
  else
    SOURCE_DIR=source
  fi
fi
OUT_DIR=${OUT_DIR:-${SOURCE_DIR}/out}
CCACHE_DIR=${CCACHE_DIR:-${RADXOID_EXTERNAL}/ccache}
REPO_JOBS=${REPO_JOBS:-}
BUILD_JOBS=${BUILD_JOBS:-}